{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "decompile:assets": "node ./scripts/decompile-assets.mjs",
    "transcode:assets": "node ./scripts/transcode-assets.mjs",
    "questions:add": "node ./scripts/add-tour-questions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node ./scripts/playwright-smoke.mjs",
    "test:resume-audio": "node ./scripts/playwright-resume-audio.mjs",
    "verify": "pnpm run test && pnpm run build && pnpm run smoke && pnpm run test:resume-audio"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "playwright": "^1.58.2",
    "sharp": "^0.35.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
